---
// src/pages/categories/index.astro
import { getCollection } from 'astro:content';
import Base from "@/layouts/Base.astro";
import { CATEGORY_HIERARCHY } from '@/lib/categories';
import dateFormat from "@/lib/utils/dateFormat";

// Helper function to calculate read time (simplified for template)
function calculateReadTime(content) {
  if (!content) return 5;
  const wordCount = content.split(/\s+/).length;
  return Math.max(1, Math.ceil(wordCount / 180));
}

// Get all posts
const allPostsRaw = await getCollection('posts', ({ data }) => !data.draft);
const allPosts = allPostsRaw.map(post => ({
  ...post,
  data: {
    ...post.data,
    readTime: calculateReadTime(post.body || "")
  }
}));

// Calculate post counts per category
const categoryPostCounts = {};
const latestCategoryPosts = {};

Object.keys(CATEGORY_HIERARCHY).forEach(category => {
  const postsInCategory = allPosts.filter(p => p.data.pillar === category);
  categoryPostCounts[category] = postsInCategory.length;
  latestCategoryPosts[category] = postsInCategory
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 2);
});

const totalPosts = allPosts.length;
const totalCategories = Object.keys(CATEGORY_HIERARCHY).length;

// Prepare category data with progress
const categoriesWithProgress = Object.entries(CATEGORY_HIERARCHY).map(([slug, category]) => {
  const postCount = categoryPostCounts[slug] || 0;
  const latestPosts = latestCategoryPosts[slug] || [];
  
  // Determine category status
  let categoryStatus = 'New path';
  if (postCount > 0 && postCount <= 3) categoryStatus = 'Initial Scan';
  else if (postCount > 3 && postCount <= 7) categoryStatus = 'Infiltrating';
  else if (postCount > 7) categoryStatus = 'Deep Intel';
  
  // Calculate progress
  const progressWidth = Math.min(100, (postCount / 10) * 100);
  
  return {
    slug,
    ...category,
    postCount,
    latestPosts,
    categoryStatus,
    progressWidth
  };
});
---

<Base title="Defensive Intelligence Pillars" 
      description="Explore the 6 pillars of defensive market intelligence. From systemic risk to macro liquidity contraction.">
  
  <!-- 🧬 BEAR_INFRASTRUCTURE: INDUSTRIAL HERO -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden dark:bg-[#050607] bg-white border-b border-gray-100 dark:border-white/5 font-mono">
    <!-- Grid Overlay -->
    <div class="absolute inset-0 pointer-events-none z-0 opacity-[0.05]" style="background-image: radial-gradient(circle, #ff3333 1px, transparent 1px); background-size: 32px 32px;"></div>
    
    <div class="absolute top-0 left-0 w-full h-full pointer-events-none z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-red-600/10 blur-[120px] rounded-full"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-zinc-900/40 blur-[120px] rounded-full"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 py-24">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col items-center text-center">
            <!-- OS Status Badge -->
            <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-gray-50/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 backdrop-blur-md mb-8 animate-fade-in">
              <div class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></div>
              <span class="text-[10px] font-black text-gray-500 dark:text-red-500 uppercase tracking-[0.3em] italic">Intelligence_Matrix_Active</span>
            </div>

            <h1 class="text-5xl md:text-8xl font-black mb-8 tracking-tighter uppercase italic leading-[0.85] dark:text-white text-gray-900">
              The <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-red-400">Pillar</span><br/>Index<span class="blinking-cursor">_</span>
            </h1>

            <div class="h-1.5 w-32 bg-gradient-to-r from-red-600 to-zinc-800 mb-8"></div>

            <p class="text-sm md:text-base font-bold text-gray-500 dark:text-gray-400 tracking-[0.1em] uppercase max-w-2xl leading-relaxed">
                Structured defensive fragments mapped across {totalCategories} risk pillars. 
                Full access to {totalPosts} validated intelligence units.
            </p>

            <!-- Metadata Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 w-full max-w-4xl">
              <div class="p-6 rounded-[2rem] bg-gray-50/50 dark:bg-white/5 border border-gray-100 dark:border-white/10 backdrop-blur-md">
                <div class="text-[10px] text-gray-400 uppercase tracking-widest mb-1">Architecture</div>
                <div class="text-2xl font-black text-red-500">{totalCategories} Pillars</div>
              </div>
              <div class="p-6 rounded-[2rem] bg-gray-50/50 dark:bg-white/5 border border-gray-100 dark:border-white/10 backdrop-blur-md">
                <div class="text-[10px] text-gray-400 uppercase tracking-widest mb-1">Intel Units</div>
                <div class="text-2xl font-black text-red-400">{totalPosts} Units</div>
              </div>
              <div class="p-6 rounded-[2rem] bg-gray-50/50 dark:bg-white/5 border border-gray-100 dark:border-white/10 backdrop-blur-md">
                <div class="text-[10px] text-gray-400 uppercase tracking-widest mb-1">Risk_Status</div>
                <div class="text-2xl font-black text-red-600 italic">CRITICAL</div>
              </div>
              <div class="p-6 rounded-[2rem] bg-gray-50/50 dark:bg-white/5 border border-gray-100 dark:border-white/10 backdrop-blur-md">
                <div class="text-[10px] text-gray-400 uppercase tracking-widest mb-1">Access</div>
                <div class="text-2xl font-black text-white italic">OPEN</div>
              </div>
            </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 🦾 CORE MODULES: ALL PILLARS -->
  <section id="all-pillars" class="py-32 dark:bg-[#050607] bg-gray-50 font-mono relative border-t border-gray-100 dark:border-white/5">
    <!-- Grid Overlay -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.07] pointer-events-none" style="background-image: radial-gradient(#ff3333 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-24">
        <h2 class="text-5xl md:text-7xl font-black mb-8 tracking-tighter uppercase italic leading-[0.85] dark:text-white text-gray-900">
          The <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-red-400">Tactical</span> Grid_
        </h2>
        <div class="h-1.5 w-32 bg-gradient-to-r from-red-600 to-zinc-800 mx-auto mb-6"></div>
        <p class="text-[10px] font-bold text-gray-500 dark:text-gray-400 tracking-[0.4em] uppercase">Comprehensive Access to all Defensive Modules</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {categoriesWithProgress.map((category) => (
          <div class="group relative overflow-hidden p-10 transition-all duration-300 rounded-[2.5rem] border backdrop-blur-md hover:-translate-y-2 flex flex-col items-start min-h-[500px] bg-gray-50/50 dark:bg-[#080808] border-gray-100 dark:border-white/10 hover:border-red-500/50 shadow-xl">
            
            <div class="absolute top-0 right-0 p-8 text-[9px] font-black uppercase tracking-widest italic opacity-20 group-hover:opacity-100 transition-opacity text-red-500">
              MOD_DEF_{category.slug.toUpperCase().slice(0,4)}
            </div>

            <div class="text-5xl mb-8 group-hover:scale-110 transition-transform duration-500">
              {category.icon}
            </div>

            <h3 class="text-3xl font-black dark:text-white text-gray-900 uppercase italic tracking-tighter mb-4 group-hover:text-red-500 transition-colors">
              {category.name}
            </h3>

            <div class="flex items-center gap-3 mb-6">
                <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">
                    {category.postCount} Intel Fragments
                </span>
                <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-widest bg-red-500/10 text-red-600">
                    {category.categoryStatus}
                </span>
            </div>

            <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase leading-relaxed mb-auto">
              {category.description}
            </p>

            <!-- Metadata Terminal Layout -->
            <div class="w-full mt-10 pt-8 border-t border-gray-100 dark:border-white/5">
              <div class="flex items-center justify-between mb-4">
                 <div class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Protocol_Sync</div>
                 <div class="text-[9px] font-black uppercase tracking-widest italic animate-pulse text-red-500">
                   {Math.round(category.progressWidth)}% SYNCED
                 </div>
              </div>

              <!-- Compact Progress -->
              <div class="flex items-center gap-3 mb-8">
                <div class="flex-1 h-1.5 bg-gray-100 dark:bg-white/10 rounded-full overflow-hidden p-[1px]">
                  <div class="h-full bg-red-600 rounded-full transition-all duration-1000 shadow-[0_0_10px_rgba(255,51,51,0.5)]" 
                    style={{"width": `${category.progressWidth}%`}}></div>
                </div>
              </div>

              <!-- Intel Preview -->
              <div class="space-y-2 mb-8">
                <div class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-3 italic">Intelligence_Log:</div>
                {category.latestPosts.length > 0 ? (
                    category.latestPosts.map(post => (
                        <a href={`/bear/blog/${post.data.pillar}/${post.data.subcategory}/${post.slug.split('/').pop()}`} class="flex items-center justify-between p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-transparent hover:border-red-500/20 transition-all group/item">
                            <span class="text-[10px] font-bold text-gray-400 uppercase italic line-clamp-1 group-hover/item:text-red-500">{post.data.title}_</span>
                        </a>
                    ))
                ) : (
                    <div class="p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-transparent text-[10px] font-bold text-gray-400 uppercase italic">
                        Scanning_For_Data...
                    </div>
                )}
              </div>

              <a href={`/bear/categories/${category.slug}`} 
                 class="w-full py-4 text-[10px] font-black uppercase tracking-widest italic rounded-2xl flex items-center justify-center gap-2 transition-all bg-red-600 text-white hover:bg-black hover:text-red-500 shadow-xl">
                <span>INITIALIZE_DEEP_SCAN_→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .blinking-cursor {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
