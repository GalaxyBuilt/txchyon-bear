---
import Base from "@/layouts/Base.astro";
---

<Base title="Txchyon Bear // Defensive Intelligence Newsletter" 
      description="Get systemic risk alerts, liquidity contraction reports, and defensive alpha directly to your inbox. Join the Bear intelligence division.">
  
  <section class="min-h-screen bg-[#050607] py-20 relative overflow-hidden font-mono">
    <!-- Grid Overlay -->
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, #ff3333 1px, transparent 1px); background-size: 32px 32px;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-2xl mx-auto text-center">
        <div class="bg-black/40 backdrop-blur-xl rounded-[3rem] border border-red-500/30 p-8 lg:p-12 shadow-2xl shadow-red-900/10">
          <div class="text-6xl mb-8 animate-pulse">📡</div>
          
          <h1 class="text-4xl md:text-5xl font-black text-white mb-6 uppercase italic tracking-tighter">
            Defensive <span class="text-red-600">Intel</span> Feed
          </h1>
          
          <p class="text-gray-400 text-lg mb-8 uppercase font-bold tracking-tight">
            Join 12,000+ risk-managed investors receiving exclusive contraction strategies & systemic risk reports.
            <span class="text-red-500 block mt-2"> Zero noise. Pure data.</span>
          </p>
          
          <div class="space-y-6 mb-10 text-left bg-white/5 border border-white/5 p-8 rounded-[2rem] backdrop-blur-sm">
            <div class="flex items-center gap-4">
              <span class="text-red-500 text-2xl">⚠️</span>
              <div>
                <div class="text-white font-black uppercase text-sm tracking-widest">Systemic Risk Alerts</div>
                <div class="text-gray-500 text-[10px] font-bold uppercase tracking-tight">Early warnings on protocol insolvency & contagion</div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-red-500 text-2xl">💧</span>
              <div>
                <div class="text-white font-black uppercase text-sm tracking-widest">Liquidity Analysis</div>
                <div class="text-gray-500 text-[10px] font-bold uppercase tracking-tight">Tracking the contraction of global dollar flows</div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-red-500 text-2xl">🛡️</span>
              <div>
                <div class="text-white font-black uppercase text-sm tracking-widest">Capital Preservation</div>
                <div class="text-gray-500 text-[10px] font-bold uppercase tracking-tight">Validated strategies for principal protection</div>
              </div>
            </div>
          </div>
          
          <!-- Beehiiv Embed Form -->
          <div class="mb-10 p-4 bg-white/5 rounded-[2rem] border border-white/10">
            <div class="beehiiv-embed-container bg-transparent">
              <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
              <iframe 
                src="https://subscribe-forms.beehiiv.com/62d85daa-7878-4a83-a78a-a15f6226c516" 
                class="beehiiv-embed" 
                data-test-id="beehiiv-embed" 
                frameborder="0" 
                scrolling="no" 
                style="width: 100%; max-width: 508px; height: 198px; margin: 0 auto; border-radius: 0px !important; background-color: transparent; box-shadow: none;">
              </iframe>
            </div>
          </div>
          
          <p class="text-gray-600 text-[10px] mb-10 font-bold uppercase tracking-widest leading-relaxed">
            By authenticating, you agree to our <a href="/privacy" class="text-red-500 hover:text-red-400">Privacy Protocols</a>.
          </p>
          
          <div class="mt-12 pt-10 border-t border-white/5 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/bear" 
               class="px-8 py-4 border border-zinc-800 text-zinc-500 rounded-2xl hover:bg-zinc-900 transition-all text-xs font-black uppercase tracking-widest italic flex items-center justify-center gap-2">
              ← Return to Matrix
            </a>
            <a href="/bear/blog" 
               class="px-8 py-4 bg-red-600 text-white rounded-2xl hover:bg-black hover:text-red-500 transition-all text-xs font-black uppercase tracking-widest italic flex items-center justify-center gap-2 shadow-xl shadow-red-900/20">
              📚 Enter Vault
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .beehiiv-embed-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 200px;
    }
    
    .beehiiv-embed iframe {
      background-color: transparent !important;
      filter: invert(1) hue-rotate(180deg) brightness(1.5) contrast(1.2); /* Invert to match dark theme if needed, but the form usually has its own styles */
    }
    
    @media (min-width: 768px) {
      .beehiiv-embed iframe {
        max-width: 508px;
      }
    }
  </style>
</Base>
