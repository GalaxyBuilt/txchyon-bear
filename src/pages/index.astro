import { getCollection } from 'astro:content';



import Base from "@/layouts/Base.astro";



import Posts from "@/layouts/components/Posts.astro";



import Pagination from "@/layouts/components/Pagination.astro";



import { CATEGORY_HIERARCHY } from '@/lib/categories';



import BearGenesisPreview from "../partials/BearGenesisPreview.astro";







// Helper function for automatic readTime calculation



function calculateReadTime(content, wordsPerMinute = 130) {



if (!content) return 10;







const plainText = content



.replace(/---[\s\S]*?---/, '')



.replace(/```[\s\S]*?```/g, '')



.replace(/<[^>]*>/g, '')



    .replace(/#{1,6}\s*/g, '')



    .replace(/[\[\]\(\)]/g, ' ')



    .replace(/\s+/g, ' ')



    .trim();







    const wordCount = plainText.split(/\s+/).length;



    const minutes = Math.ceil(wordCount / wordsPerMinute);







    return Math.max(1, Math.min(minutes, 60));



    }







    function getPostReadTime(post) {



    if (post.data.readTime) return post.data.readTime;



    if (post.body) return calculateReadTime(post.body);







    const estimates = {



    'macro-liquidity': 8,



    'systemic-risk': 10,



    'fraud-red-flags': 12,



    'bearish-frameworks': 15,



    'crowd-psychology': 12,



    'capital-preservation': 14



    };







    return estimates[post.data.category] || 10;



    }







    const allPostsRaw = await getCollection('posts', ({ data }) => !data.draft);



    const allPosts = allPostsRaw.map(post => ({



    ...post,



    data: {



    ...post.data,



    readTime: getPostReadTime(post)



    }



    }));







    const sortedPosts = allPosts.sort(



    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()



    );







    const featuredPost = sortedPosts[0];



    const latestPosts = sortedPosts.slice(1, 8);







    // Bearish Pillar Categories



    const BEAR_PILLARS = [



    { id: 'macro-liquidity', name: 'Macro_Liquidity', icon: '💧', color: 'from-red-600 to-orange-700', border:



    'bear-border-accent', bg: 'bg-red-500/10 dark:bg-red-950/20', hover: 'hover:border-red-600', text: 'text-red-500' },



    { id: 'systemic-risk', name: 'Systemic_Risk', icon: '⚠️', color: 'from-amber-600 to-red-700', border:



    'bear-border-accent', bg: 'bg-amber-500/10 dark:bg-amber-950/20', hover: 'hover:border-amber-500', text: 'text-amber-500' },



    { id: 'fraud-red-flags', name: 'Fraud_&_Red_Flags', icon: '🚩', color: 'from-red-600 to-rose-700', border:



    'bear-border-accent', bg: 'bg-red-500/10 dark:bg-red-950/20', hover: 'hover:border-rose-500', text: 'text-rose-500' },



    { id: 'bearish-frameworks', name: 'Bearish_Frameworks', icon: '📉', color: 'from-orange-600 to-red-700', border:



    'bear-border-accent', bg: 'bg-orange-500/10 dark:bg-orange-950/20', hover: 'hover:border-orange-500', text: 'text-orange-500' },



    { id: 'crowd-psychology', name: 'Crowd_Psychology', icon: '🧠', color: 'from-stone-600 to-red-700', border:



    'border-stone-900/30', bg: 'bg-stone-950/20', hover: 'hover:border-stone-500', text: 'text-stone-500' },



    { id: 'capital-preservation', name: 'Capital_Preservation', icon: '🛡️', color: 'from-emerald-900 to-red-800',



    border: 'bear-border-accent', bg: 'bg-emerald-500/10 dark:bg-emerald-950/20', hover: 'hover:border-emerald-500', text:



    'text-emerald-500' }



    ];







    const categoryPosts = {};



    const categoryPostCounts = {};







    BEAR_PILLARS.forEach(pillar => {



    const allPostsInCategory = sortedPosts.filter(p => p.data.category === pillar.id);



    categoryPostCounts[pillar.id] = allPostsInCategory.length;



    categoryPosts[pillar.id] = allPostsInCategory



    .filter(p => p.slug !== featuredPost?.slug)



    .slice(0, 3);



    });







    const realisticStats = {



    reportsPublished: allPosts.length.toString(),



    defensiveNodes: "850+",



    riskFlags: "230+",



    monthsActive: "1"



    };



