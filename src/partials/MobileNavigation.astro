---
// src/partials/MobileNavigation.astro
---

<!-- 📱 MOBILE OVERLAY SYSTEM -->
<div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[60] hidden transition-opacity duration-300"></div>

<div
  id="mobile-menu-panel"
  class="fixed inset-y-0 right-0 w-[85%] max-w-[400px] bear-bg-main bear-border-muted border-l shadow-[20px_0_60px_rgba(0,0,0,0.5)] z-[70] overflow-y-auto translate-x-full transition-transform duration-300 ease-out"
>
  <!-- Terminal Background Pattern -->
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.1] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
  
  <div class="relative z-10 p-6 flex flex-col h-full">
    <!-- Mobile Header Meta -->
    <div class="flex justify-between items-center mb-8 pb-4 bear-border-muted border-b">
        <div class="flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
            <span class="text-[10px] font-black text-red-500 uppercase tracking-[0.2em] italic">BEAR_OS_Active</span>
        </div>
        <button id="mobile-menu-close" class="p-2 bear-text-dim hover:bear-text-main transition-colors rounded-xl hover:bg-black/5 dark:hover:bg-white/5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- 🌐 NAVIGATION NODES -->
    <nav class="flex-1 overflow-y-auto">
      <div class="space-y-8">
        
        <!-- 1. Primary Entry Points -->
        <div class="space-y-2">
          <a href="/bear/blog" class="flex items-center justify-between px-4 py-4 rounded-xl text-sm font-black bear-text-main hover:text-red-500 dark:hover:text-red-400 hover:bg-black/5 dark:hover:bg-white/5 transition-all italic border border-transparent hover:border-red-500/10 uppercase tracking-tighter">
            <span>Threat Archives_</span>
            <span class="text-red-500/30 text-[10px] font-mono tracking-tighter">[INTEL]</span>
          </a>
          <a href="/bear/categories" class="flex items-center justify-between px-4 py-4 rounded-xl text-sm font-black bear-text-main hover:text-red-500 dark:hover:text-red-400 hover:bg-black/5 dark:hover:bg-white/5 transition-all italic border border-transparent hover:border-red-500/10 uppercase tracking-tighter">
            <span>Risk Pillars_</span>
            <span class="text-red-500/30 text-[10px] font-mono tracking-tighter">[INDEX]</span>
          </a>
        </div>

        <!-- 2. Ecosystem Transition Section -->
        <div>
          <div class="text-[9px] font-black bear-text-dim uppercase tracking-[0.4em] px-4 py-2 flex items-center gap-3 mb-2">
            <span class="opacity-30">🚀</span>
            <span>Ecosystem Switch</span>
          </div>
          <div class="grid grid-cols-1 gap-1">
            <a href="https://txchyon.com" class="flex items-center gap-3 px-4 py-3 rounded-xl text-[11px] font-black bear-text-muted hover:text-green-500 transition-all uppercase tracking-tight">
              <span class="text-green-500/40 font-mono">1</span>
              <span>Bull Side (Genesis)</span>
            </a>
          </div>
        </div>

        <!-- 3. Final Main Link -->
        <a href="/shop" class="flex items-center justify-between px-4 py-4 rounded-xl text-sm font-black bear-text-main hover:text-red-500 dark:hover:text-red-400 hover:bg-black/5 dark:hover:bg-white/5 transition-all italic border border-transparent hover:border-red-500/10 uppercase tracking-tighter">
          <span>Access Passes_</span>
          <span class="text-red-500/30 text-[10px] font-mono tracking-tighter">[STORE]</span>
        </a>

      </div>
    </nav>

    <!-- Mobile Footer Utils -->
    <div class="pt-8 bear-border-muted border-t space-y-4">
       <!-- Main CTAs -->
       <div class="grid grid-cols-1 gap-3">
          <a href="/shop" class="flex items-center justify-center py-4 bg-black dark:bg-white text-white dark:text-black rounded-xl active:scale-95 transition-all font-black text-xs uppercase tracking-[0.2em] italic shadow-lg">
            Get_Passes_⚡
          </a>
       </div>
       
       <div class="flex justify-between items-center px-2 pt-2">
          <div class="flex gap-5">
            <a href="https://twitter.com/txchyon" class="bear-text-dim hover:text-red-500 font-black uppercase text-[9px] tracking-[0.2em] transition-colors">Twitter</a>
            <a href="/bear/newsletter" class="bear-text-dim hover:text-red-500 font-black uppercase text-[9px] tracking-[0.2em] transition-colors">Intel</a>
          </div>
          <span class="text-[8px] bear-text-dim font-mono tracking-[0.3em] opacity-40">v1.0_BEAR</span>
       </div>
    </div>
  </div>
</div>
